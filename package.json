{
  "name": "slidev-theme-penguin",
  "type": "module",
  "version": "2.3.1",
  "packageManager": "bun@1.3.1",
  "description": "A Penguin theme for Slidev",
  "author": "Alvaro Saburido <hola@alvarosaburido.dev>",
  "license": "MIT",
  "homepage": "https://penguin-theme.alvarosaburido.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvarosaburido/slidev-theme-penguin.git"
  },
  "bugs": "https://github.com/alvarosaburido/slidev-theme-penguin/issues",
  "keywords": [
    "slidev-theme",
    "slidev",
    "slidev-penguin"
  ],
  "slidev": {
    "colorSchema": "both",
    "highlighter": "shiki",
    "default": {
      "aspectRatio": "16/9",
      "fonts": {
        "sans": "Inter",
        "title": "Gilroy",
        "mono": "Fira Code"
      }
    }
  },
  "scripts": {
    "dev": "slidev example.md --open",
    "build": "slidev build example.md",
    "export": "slidev export example.md",
    "release": "release-it",
    "screenshot": "slidev export example.md --format png",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@alvarosabu/ui": "3.1.0",
    "@slidev/types": "0.51.0-beta.4",
    "prism-theme-vars": "0.2.5",
    "vite-svg-loader": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@iconify-json/la": "1.2.1",
    "@iconify-json/logos": "1.2.10",
    "@iconify-json/simple-icons": "1.2.66",
    "@release-it/conventional-changelog": "10.0.4",
    "@slidev/cli": "0.51.0-beta.4",
    "playwright-chromium": "1.57.0",
    "release-it": "19.2.3",
    "sass": "1.97.2"
  }
}
